    },
    "Chỉ đồng bộ tuỳ chọn kiểu gõ và bảng gõ tắt giữa Mac, iPhone và iPad. Không đồng bộ văn bản đang gõ." : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only syncs typing options and shortcuts across Mac, iPhone, and iPad. Never syncs typed text." } } }
    },
